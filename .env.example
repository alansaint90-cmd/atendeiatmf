# Copie para .env no ambiente local. Nunca inclua credenciais neste exemplo.
# No EasyPanel, cadastrar os valores na seção de variáveis de ambiente.

APP_URL=http://127.0.0.1:8000

# OpenAI — somente servidor; não usar prefixo NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=

# PostgreSQL 16: postgresql://USUARIO:SENHA@HOST:5432/BANCO
DATABASE_URL=

# Evolution API — instalação existente; URL base sem /manager.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Segredo exclusivo para autenticar o webhook (mínimo de 32 caracteres aleatórios).
# Enviar o mesmo valor no header x-webhook-secret do webhook da Evolution.
EVOLUTION_WEBHOOK_SECRET=

# Redis do AtendeIA: redis://default:SENHA@HOST:6379/0 (rediss:// para TLS).
REDIS_URL=

# O webhook recebe eventos no Redis; o processamento e as respostas por IA ainda não existem.
