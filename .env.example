# Copie para .env no ambiente local. Nunca inclua credenciais neste exemplo.
# No EasyPanel, cadastrar os valores na seção de variáveis de ambiente.

APP_URL=http://127.0.0.1:8000

# OpenAI — somente servidor; não usar prefixo NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=

# PostgreSQL 16: postgresql://USUARIO:SENHA@HOST:5432/BANCO
DATABASE_URL=

# PostgreSQL local via Docker Compose. Defina senha própria antes de pnpm db:up.
# Use estes mesmos dados na DATABASE_URL local; não alteram o banco do EasyPanel.
DB_NAME=projeto_dev
DB_USER=dev
DB_PASSWORD=
DB_PORT=5432

# Token administrativo aleatório: mínimo de 32 caracteres, somente no servidor.
SETTINGS_ADMIN_TOKEN=
# Chave AES: 32 bytes em base64. Guardar backup; não trocar após salvar dados.
# Gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=

# Evolution API — instalação existente; URL base sem /manager.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Segredo exclusivo para autenticar o webhook (mínimo de 32 caracteres aleatórios).
# Enviar o mesmo valor no header x-webhook-secret do webhook da Evolution.
EVOLUTION_WEBHOOK_SECRET=

# Redis do AtendeIA: redis://default:SENHA@HOST:6379/0 (rediss:// para TLS).
REDIS_URL=

# Processador contínuo: habilitar no serviço Next.js do EasyPanel e implantar.
# Não habilitar localmente com credenciais da produção.
ATENDEIA_WORKER_ENABLED=false
# Também pode ser ativado/desativado em Configurações, com token administrativo.
AI_ENABLED=false
# Contexto editável no painel; salvo no servidor prevalece sobre este valor.
AI_SYSTEM_PROMPT=

# Follow-ups: configure pela página Follow-ups automáticos (salvamento criptografado).
# Autenticação individual em implementação. Ativar somente após provisionamento e validação.
AUTH_LOGIN_ENABLED=false
# Origem HTTPS exata, sem barra final. Desenvolvimento: http://localhost:8001
AUTH_ORIGIN=
# FOLLOW_UP_CONFIG é JSON validado, com revisão gerada pelo servidor; não preencher manualmente.
