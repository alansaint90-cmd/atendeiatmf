{
  "name": "atendeia-tmf",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 8000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 8000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate --config=config/drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "next": "^16.0.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.19.0"
}
